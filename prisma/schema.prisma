// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                String       @id @default(cuid())
  slug              String       @unique
  name              String
  adminEmail        String       @unique @map("admin_email")
  adminPassword     String       @map("admin_password")
  logo              String?
  senderName        String?      @map("sender_name")
  primaryColor      String       @default("#1b2055") @map("primary_color")
  accentColor       String       @default("#2dd17c") @map("accent_color")
  backgroundColor   String       @default("#0f172a") @map("background_color")
  pin               String       @default("1234")
  settings          Json         @default("{}")
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  submissions       Submission[]
  interviewSlots    InterviewSlot[]

  @@map("tenants")
}

model InterviewSlot {
  id        String             @id @default(cuid())
  tenantId  String             @map("tenant_id")
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startsAt  DateTime           @map("starts_at")
  endsAt    DateTime           @map("ends_at")
  location  String
  quota     Int                @default(5)
  notes     String?
  createdAt DateTime           @default(now()) @map("created_at")
  bookings  InterviewBooking[]

  @@index([tenantId, startsAt])
  @@map("interview_slots")
}

model InterviewBooking {
  id           String        @id @default(cuid())
  slotId       String        @map("slot_id")
  slot         InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  submissionId String        @unique @map("submission_id")
  submission   Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  notifiedAt   DateTime?     @map("notified_at")
  bookedAt     DateTime      @default(now()) @map("booked_at")

  @@index([slotId])
  @@map("interview_bookings")
}

model NotificationLog {
  id           String     @id @default(cuid())
  submissionId String     @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  channel      String
  type         String
  status       String
  payload      Json?
  error        String?
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([submissionId])
  @@map("notification_logs")
}

model Submission {
  id            String             @id @default(cuid())
  tenantId      String             @map("tenant_id")
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  data          Json
  files         Json
  status        String             @default("nuevo")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  booking       InterviewBooking?
  notifications NotificationLog[]

  @@index([tenantId])
  @@map("submissions")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("admin") // super_admin, tenant_admin
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}
