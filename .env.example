# Copiar a .env en el servidor: cp .env.example .env && nano .env
#
# Dominio: forms.renace.tech (NO catagce — es otro servicio)

NEXT_PUBLIC_BASE_URL=https://forms.renace.tech

# App en Docker → Postgres en el host (Odoo puede usar el mismo servidor Postgres)
DATABASE_URL=postgresql://renaceforms:CAMBIAR_PASSWORD@host.docker.internal:5432/renace_forms

# Migraciones en el host (prisma db push) — socket UNIX, no reinicia Postgres
DATABASE_URL_MIGRATE=postgresql://renaceforms:CAMBIAR_PASSWORD@localhost/renace_forms?host=/var/run/postgresql

# Super Admin — https://forms.renace.tech/admin
SUPER_ADMIN_EMAIL=admin@renace.tech
SUPER_ADMIN_PASSWORD=CAMBIAR_PASSWORD
ADMIN_SESSION_SECRET=CAMBIAR_TOKEN_LARGO_ALEATORIO

# SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
