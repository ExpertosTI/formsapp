# En el servidor: ./scripts/provision-production.sh crea .env de producción.
# WhatsApp (Evolution API) — usa las mismas variables que ya tengas configuradas:

# EVOLUTION_API_URL=https://tu-servidor-evo.com
# EVOLUTION_API_KEY=tu_api_key
# EVOLUTION_INSTANCE=nombre_instancia

# Alias compatibles:
# EVO_API_URL=  EVO_API_KEY=  EVO_INSTANCE=
# WHATSAPP_API_URL=  WHATSAPP_API_KEY=  WHATSAPP_INSTANCE=
