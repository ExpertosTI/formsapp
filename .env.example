# Copiar a .env en el servidor: cp .env.example .env && nano .env

# Dominio público
NEXT_PUBLIC_BASE_URL=https://catagce.renace.tech

# PostgreSQL (ajustar host si Postgres corre en otro contenedor/servidor)
DATABASE_URL=postgresql://talentolink:CAMBIAR_PASSWORD@localhost:5432/talentolink

# Super Admin — panel /admin
SUPER_ADMIN_EMAIL=admin@renace.tech
SUPER_ADMIN_PASSWORD=CAMBIAR_PASSWORD
ADMIN_SESSION_SECRET=CAMBIAR_TOKEN_LARGO_ALEATORIO

# SMTP (opcional, para notificaciones)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
